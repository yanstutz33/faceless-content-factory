# Copy to .env and adjust if needed.
FACTORY_DATA_DIR=data
FACTORY_HOST=127.0.0.1
FACTORY_PORT=8787
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Safe by default. The MVP never uploads when this is false.
ALLOW_PLATFORM_PUBLISH=false

# Optional future providers (not required by the local demo).
OPENAI_API_KEY=
YOUTUBE_CLIENT_SECRETS_FILE=

