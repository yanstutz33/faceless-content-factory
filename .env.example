# Copy to .env and adjust if needed.
FACTORY_DATA_DIR=data
FACTORY_HOST=127.0.0.1
FACTORY_PORT=8787
# Keep the backend on localhost. A HTTPS tunnel reaches it without opening a router port.
FACTORY_REMOTE_ACCESS=false
FACTORY_REMOTE_USERNAME=
FACTORY_REMOTE_PASSWORD=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FACTORY_WORKERS=1
CALENDAR_POLL_SECONDS=15
AUTOPILOT_MAX_REVIEW=12
AUTOPILOT_MAX_ACTIVE=2
AUTOPILOT_MIN_FREE_GB=3

# If neural voice is offline, finish the package with ambient audio instead of failing.
NARRATION_FALLBACK_TO_AMBIENT=true
LOCAL_TTS_FALLBACK=true
TTS_PROVIDER=edge
TTS_VOICE=pt-BR-AntonioNeural
TTS_RATE=-8%
TTS_PITCH=-2Hz
TTS_TIMEOUT_SECONDS=180

# Safe by default. The MVP never uploads when this is false.
ALLOW_PLATFORM_PUBLISH=false

# Optional future providers (not required by the local demo).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

# Google Lyria 3 music generation. You can also paste this key into the encrypted hub vault.
GEMINI_API_KEY=
LYRIA_MODEL=lyria-3-pro-preview
LYRIA_TIMEOUT_SECONDS=300
# Keep false until the new musical batch has actually been listened to and approved.
MUSIC_CATALOG_HUMAN_APPROVED=false
YOUTUBE_CLIENT_SECRETS_FILE=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://127.0.0.1:8787/api/oauth/callback/tiktok
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://127.0.0.1:8787/api/oauth/callback/reels
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# Local encrypted credentials and automatic database snapshots.
FACTORY_BACKUP_KEEP=10
